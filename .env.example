FINDYOU_API_TOKEN=replace-me
FINDYOU_DATA_DIR=data
FINDYOU_SQLITE_JOURNAL_MODE=WAL
FINDYOU_HOST=127.0.0.1
FINDYOU_PORT=8765
FINDYOU_LLM_PROVIDER=deepseek
FINDYOU_LLM_MODEL=deepseek-flash
FINDYOU_LLM_API_KEY=
# Optional override; default provider URL is selected automatically.
FINDYOU_LLM_BASE_URL=
FINDYOU_BILI_PYTHON=.venv-bili/Scripts/python.exe
# Conservative UTF-8 input-size estimate plus output reserve. Full role cards are never silently truncated.
FINDYOU_AGENT_CONTEXT_TOKENS=16000
# Applies to the new agent decision/extraction flows, not the provider account's total spending.
FINDYOU_AGENT_DAILY_MODEL_CALLS=20
